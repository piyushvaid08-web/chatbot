# Copy this file to .env and fill in your values.
# Get an OpenAI API key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# Optional: point to any OpenAI-compatible API by changing base URL + model.
# Examples:
#   DeepSeek:   https://api.deepseek.com/v1  + model "deepseek-chat"
#   Groq:       https://api.groq.com/openai/v1  + model "llama-3.3-70b-versatile"
#   Google:     https://generativelanguage.googleapis.com/v1beta/openai  + model "gemini-2.0-flash"
#   OpenRouter: https://openrouter.ai/api/v1  + model "openai/gpt-4o-mini"
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Embedding model used to search inside your uploaded files.
# Set to "off" for providers without an embeddings endpoint (e.g. OpenRouter).
EMBEDDING_MODEL=text-embedding-3-small

# Where uploaded files are stored.
DATA_DIR=data